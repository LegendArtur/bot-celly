{
  "name": "bot-celly",
  "version": "0.4.0",
  "description": "Drive OpenCode coding agents from Discord, with one isolated microVM per project.",
  "keywords": [
    "discord",
    "discord-bot",
    "opencode",
    "coding-agent",
    "ai-agent",
    "ai-coding-assistant",
    "llm",
    "claude",
    "gpt",
    "sandbox",
    "microvm",
    "developer-tools",
    "automation",
    "self-hosted",
    "typescript"
  ],
  "homepage": "https://celly.agub.dev",
  "bugs": {
    "url": "https://github.com/LegendArtur/bot-celly/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LegendArtur/bot-celly.git"
  },
  "license": "MIT",
  "author": "Artur Gubaidullin <29106800+LegendArtur@users.noreply.github.com>",
  "type": "module",
  "main": "index.js",
  "bin": {
    "bot-celly": "dist/cli.js"
  },
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prepack": "npm run build",
    "prepublishOnly": "npm test && npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "changeset": "changeset",
    "changeset:version": "changeset version && npm run changelog:sync",
    "changelog:sync": "node scripts/sync-changelog.mjs",
    "docs:dev": "cd docs-site && npx -y mint@latest dev",
    "docs:validate": "cd docs-site && npx -y mint@latest validate",
    "docs:links": "cd docs-site && npx -y mint@latest broken-links"
  },
  "dependencies": {
    "@opencode-ai/sdk": "1.18.32",
    "discord.js": "14.27.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "publishConfig": {
    "access": "public"
  }
}
