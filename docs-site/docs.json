{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Celly Bot",
  "theme": "almond",
  "colors": {
    "primary": "#0039FF",
    "light": "#00FFBD",
    "dark": "#045300"
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/LegendArtur/bot-celly",
          "icon": "github"
        },
        {
          "anchor": "Kimaki inspiration",
          "href": "https://github.com/remorses/kimaki",
          "icon": "lightbulb"
        }
      ]
    },
    "groups": [
      {
        "group": "Get started",
        "pages": ["index", "quickstart"]
      },
      {
        "group": "Guides",
        "pages": [
          "guides/configuration",
          "guides/providers",
          "guides/terminal-attach",
          "guides/deployment"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/commands",
          "reference/architecture",
          "reference/security"
        ]
      },
      {
        "group": "Project",
        "pages": ["changelog", "contributing"]
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/LegendArtur/bot-celly"
    }
  },
  "icons": {
    "library": "fontawesome"
  },
  "background": {
    "color": {
      "light": "#D9D9D9"
    },
    "decoration": "gradient"
  }
}
