{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Celly",
  "theme": "almond",
  "colors": {
    "primary": "#FF9756",
    "dark": "#FF9756",
    "light": "#FF9756"
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/LegendArtur/bot-celly",
          "icon": "github"
        },
        {
          "anchor": "Kimaki inspiration",
          "href": "https://github.com/remorses/kimaki",
          "icon": "lightbulb"
        }
      ]
    },
    "groups": [
      {
        "group": "Get started",
        "pages": ["index", "quickstart"]
      },
      {
        "group": "Guides",
        "pages": [
          "guides/configuration",
          "guides/providers",
          "guides/terminal-attach",
          "guides/deployment",
          "guides/deployment-linux"
        ]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/commands",
          "reference/architecture",
          "reference/security"
        ]
      },
      {
        "group": "Project",
        "pages": ["changelog", "contributing"]
      }
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/LegendArtur/bot-celly"
    }
  },
  "icons": {
    "library": "fontawesome"
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "fonts": {
    "family": "Poppins"
  },
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/LegendArtur/bot-celly"
    }
  }
}
