# Celly configuration — only the first two values are required.
# Everything below them has a working default; uncomment only to override.

DISCORD_TOKEN=
DISCORD_GUILD_ID=

# # Optional. Defaults to %USERPROFILE%\Celly\projects (macOS/Linux: ~/Celly/projects).
# PROJECTS_ROOT=

# # Access / ownership (Discord role IDs, not names).
# ACCESS_ROLE_ID=
# BLOCK_ROLE_ID=
# OWNER_ROLE_ID=
# CATEGORY_ID=

# # Sandbox.
# SANDBOX_TEMPLATE=opencode
# SANDBOX_CPUS=2
# SANDBOX_MEMORY=4g
# PORT_RANGE_START=4300
# PORT_RANGE_END=4399

# # Models (also settable per thread with /model and /agent).
# DEFAULT_MODEL=
# DEFAULT_AGENT=

# # Timeouts (milliseconds).
# BOOT_TIMEOUT_MS=120000
# HEALTH_TIMEOUT_MS=30000
# EDIT_INTERVAL_MS=1200

# # Limits.
# ATTACHMENT_MAX_BYTES=102400
# MAX_QUEUE=20
# MAX_CONCURRENT_RUNS=4

# # Storage / logging.
# DATA_DIR=./data
# LOG_LEVEL=info
