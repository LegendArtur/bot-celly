# Celly configuration — only the first two values are required.
# Everything below them has a working default; uncomment only to override.

DISCORD_TOKEN=
# One or more guild IDs, comma-separated. DISCORD_GUILD_ID (single guild) is
# still accepted when DISCORD_GUILD_IDS is unset.
DISCORD_GUILD_IDS=
# DISCORD_GUILD_ID=

# # Optional. Defaults to %USERPROFILE%\Celly\projects (macOS/Linux: ~/Celly/projects).
# PROJECTS_ROOT=

# # Access / ownership (Discord role IDs, not names).
# ACCESS_ROLE_ID=
# BLOCK_ROLE_ID=
# OWNER_ROLE_ID=
# CATEGORY_ID=

# # Sandbox.
# SANDBOX_TEMPLATE=opencode
# SANDBOX_CPUS=2
# SANDBOX_MEMORY=4g
# PORT_RANGE_START=4300
# PORT_RANGE_END=4399

# # Models (also settable per thread with /model and /agent).
# DEFAULT_MODEL=
# DEFAULT_AGENT=

# # Approvals: auto | buttons | plan (seeded once into settings).
# APPROVAL_MODE=buttons

# # Timeouts (milliseconds).
# BOOT_TIMEOUT_MS=120000
# HEALTH_TIMEOUT_MS=30000
# EDIT_INTERVAL_MS=1200

# # Limits.
# ATTACHMENT_MAX_BYTES=102400
# MAX_QUEUE=20
# MAX_CONCURRENT_RUNS=4
# # Cost control. 0 disables the per-session budget (override per channel with /budget).
# SESSION_BUDGET_USD=0

# # Terminal attach.
# ATTACH_AUTO_THREAD=false
# # Worktrees: start every new session in its own git worktree. Non-git projects
# # fall back to the project root. Override per project with /worktree default.
# WORKTREE_DEFAULT=false
# # Idle auto-stop. Stop a project after N minutes without activity; 0 disables (default).
# IDLE_STOP_MINUTES=0

# # Storage / logging.
# DATA_DIR=./data
# LOG_LEVEL=info

# # Ops: loopback admin page, log rotation, and SQLite backups.
# ADMIN_PORT=4560
# LOG_MAX_BYTES=5000000
# LOG_MAX_FILES=3
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=7
